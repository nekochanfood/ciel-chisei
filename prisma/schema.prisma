generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model LearnedPost {
  postId    String   @id @map("post_id")
  authorId  String   @map("author_id")
  learnedAt DateTime @default(now()) @map("learned_at") @db.Timestamptz

  @@map("learned_posts")
}

model RepliedPost {
  postId    String   @id @map("post_id")
  replyId   String   @map("reply_id")
  repliedAt DateTime @default(now()) @map("replied_at") @db.Timestamptz

  @@map("replied_posts")
}

model MarkovEdge {
  authorId  String @default("") @map("author_id")
  prefix    String
  nextToken String @map("next")
  count     Int    @default(1)

  @@id([authorId, prefix, nextToken])
  @@index([authorId, prefix], map: "markov_edges_author_prefix_idx")
  @@index([prefix], map: "markov_edges_prefix_idx")
  @@map("markov_edges")
}

model MarkovTokenLabel {
  token    String  @id
  canStart Boolean @default(false) @map("can_start")
  canEnd   Boolean @default(false) @map("can_end")

  @@map("markov_token_labels")
}

model MarkovSequence {
  hash      String   @id
  text      String
  count     Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("markov_sequences")
}

model MarkovTokenPos {
  token  String
  pos    String
  detail String @default("")
  count  Int    @default(1)

  @@id([token, pos, detail])
  @@map("markov_token_pos")
}

model MarkovTokenForm {
  token       String
  pos         String @default("")
  basicForm   String @default("") @map("basic_form")
  conjugation String @default("")
  count       Int    @default(1)

  @@id([token, pos, basicForm, conjugation])
  @@map("markov_token_forms")
}

model MarkovPattern {
  pattern   String
  count     Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@id([pattern])
  @@map("markov_patterns")
}

model LearningBlacklist {
  userId    String   @id @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("learning_blacklist")
}
