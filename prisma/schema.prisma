generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model LearnedPost {
  postId    String   @id @map("post_id")
  authorId  String   @map("author_id")
  learnedAt DateTime @default(now()) @map("learned_at") @db.Timestamptz

  @@map("learned_posts")
}

model RepliedPost {
  postId    String   @id @map("post_id")
  replyId   String   @map("reply_id")
  repliedAt DateTime @default(now()) @map("replied_at") @db.Timestamptz

  @@map("replied_posts")
}

model Lexeme {
  surface     String
  pos         String
  detail      String @default("")
  basicForm   String @default("") @map("basic_form")
  conjugation String @default("")
  count       Int    @default(1)

  @@id([surface, pos, detail, basicForm, conjugation])
  @@index([pos], map: "lexemes_pos_idx")
  @@map("lexemes")
}

model SentenceFeature {
  postId        String @map("post_id")
  sentenceIndex Int    @map("sentence_index")
  authorId      String @map("author_id")
  features      Json

  @@id([postId, sentenceIndex])
  @@map("sentence_features")
}

model NeuralModel {
  id           String   @id
  version      Int
  exampleCount Int      @default(0) @map("example_count")
  state        Json
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("neural_models")
}

model LearningBlacklist {
  userId    String   @id @map("user_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("learning_blacklist")
}
